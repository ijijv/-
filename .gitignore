# ===== 临时产物 / 中间文件 =====
# 注意：gitignore **不支持行尾注释** —— `~$*   # 说明` 会被当成整条模式，永远匹配不上。
# 注释必须独占一行。（这条曾经踩过：锁文件和 _patch/_*.json 因此一直没被忽略。）
__pycache__/
*.pyc
_test_out/
/_thumb_*
/_t.png
*.tmp
# Office 打开文档时的锁文件（如 ~$xxx.md）
~$*
*.bak
*.orig
*.rej

# 补丁脚本的临时输出
_patch/tmp/
_patch/smoke_result.json
smoke_result.json
# 冒烟/浏览器的运行产物（每次跑都会变，不该进版本库；脚本本身照常进）
_patch/_sm.json
_patch/_sm_dist.json
_patch/_sm.err
_patch/_smoke_out.json
_patch/_dom.html
_patch/_dom.err
# 仿真器/冒烟的运行产物一律不进库（sim_baseline_v06106.json 是刻意留的基线，不以 _ 开头）
_patch/_*.json
_patch/_*.err
# 打包/冒烟的运行日志（每次跑都会变；脚本本身照常进库）
_patch/_*.log
# 由 git 现场还原的「改前树」，可随时重建：for f in js/*.js; do git show <rev>:$f > _patch/_pre/$f; done
_patch/_pre/
_patch/*.check.js

# ===== 打包产物 / 依赖 =====
# dist/ 是 打包.py 的产物，可随时重新生成，不进版本库（发给朋友的也是它）
dist/
_build/node_modules/

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini

# 补丁脚本的临时语法检查副本（node --check 用，落地即删）
_patch/_chk_*
